# ===== 필수 (비밀키 / 기본값 없음) =====
# 텍스트·이미지·가이드(LLM) 호출 전부 이 키 하나 사용
OPENAI_API_KEY=

# ===== translation 라이브(mock=false) 관련 =====
# 주의: 값과 같은 줄에 인라인 주석(KEY=값  # ...)을 쓰지 말 것.
# docker compose의 env_file은 인라인 주석을 strip하지 않아 주석이 "값"으로 들어간다
# (예: 빈 HF_TOKEN에 주석이 붙으면 Authorization: Bearer <주석> → UnicodeEncodeError). 주석은 항상 키 윗줄에.

# KURE 임베딩 다운로드용 (공개모델이면 없어도 될 수 있음)
HF_TOKEN=
# 선택: self-host Qdrant URL. 비우면 임베디드(path=) 폴백
QDRANT_URL=
# kculture 문화 각주 검색 임계치(코사인). 기본 0.55. 올리면 각주 보수적, 내리면 적극적.
# (서술형 원문 vs 카드는 KURE 코사인이 0.55~0.6 근처 → 0.6이면 정답도 잘려 endnotes 0)
WLIGHTER_ANNOTATION_SCORE_THRESHOLD=0.55

# ===== 모델 (기본값 있음 — 바꿀 때만 설정) =====
# 텍스트(채팅) 모델 단일 노브 — translation/guide/character/relationship 공통
WLIGHTER_TEXT_MODEL=gpt-5.4-mini
# 이미지(cover) 생성
WLIGHTER_IMAGE_MODEL=gpt-image-2
WLIGHTER_IMAGE_SIZE=1024x1536
WLIGHTER_IMAGE_QUALITY=medium
WLIGHTER_IMAGE_FORMAT=png

# ===== 동작 토글 (기본값 있음) =====
# true면 키/Qdrant 없이 결정적 mock
WLIGHTER_MOCK_MODE=false
# true(1)면 가이드를 LLM으로 생성 (기본: 데이터 기반 deterministic)
WLIGHTER_GUIDE_LLM=false
# 프로덕션은 1 권장(콜드스타트 방지). dev/CI는 false(빠른 부팅)
WARMUP_ON_STARTUP=false

# ===== 저장소 백엔드 =====
# 기본 memory = 인메모리(휘발성). DB 서버 없이 부팅용.
# rdb = SQLAlchemy 영속화(works/episodes/characters/translation_results). 로컬은 SQLite 파일,
#       배포는 DATABASE_URL만 MySQL로 바꾸면 됨(모델/코드 불변).
CONTENT_STORE_BACKEND=memory
# DATABASE_URL: 비우면 rdb일 때 로컬 SQLite(model_server/wlighter_local.db)로 폴백.
# MySQL 전환은 이 한 줄만 ↓ (MySQL 올라오면 주석 해제·채우기)
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/wlighter?charset=utf8mb4
DATABASE_URL=
# glossary는 별도 추상화(domains/translation/glossary): memory(기본) | mysql(raw PyMySQL).
# 저장층 컬럼명은 ERD(original_word/translated_word/glossary_type/target_country/memo)로 정렬 완료.
GLOSSARY_STORE_BACKEND=memory
# MySQL glossary 백엔드(GLOSSARY_STORE_BACKEND=mysql)용 접속 정보:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
