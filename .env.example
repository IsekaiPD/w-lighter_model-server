# ─────────────────────────────────────────────────────────────

# ===== 필수 (비밀키 / 기본값 없음) =====
# 텍스트·이미지·가이드(LLM) 호출 전부 이 키 하나 사용
OPENAI_API_KEY=

# ===== translation 라이브(mock=false) 관련 =====
HF_TOKEN=                       # KURE 임베딩 다운로드용 (공개모델이면 없어도 될 수 있음)
QDRANT_URL=                     # 선택: self-host Qdrant URL. 비우면 임베디드(path=) 폴백

# ===== 모델 (기본값 있음 — 바꿀 때만 설정) =====
# 텍스트(채팅) 모델 단일 노브 — translation/guide/character/relationship 공통
WLIGHTER_TEXT_MODEL=gpt-5.4-mini
# 이미지(cover) 생성
WLIGHTER_IMAGE_MODEL=gpt-image-2
WLIGHTER_IMAGE_SIZE=1024x1536
WLIGHTER_IMAGE_QUALITY=medium
WLIGHTER_IMAGE_FORMAT=png

# ===== 동작 토글 (기본값 있음) =====
WLIGHTER_MOCK_MODE=false        # true면 키/Qdrant 없이 결정적 mock
WLIGHTER_GUIDE_LLM=false        # true(1)면 가이드를 LLM으로 생성 (기본: 데이터 기반 deterministic)
WARMUP_ON_STARTUP=false         # 프로덕션은 1 권장(콜드스타트 방지). dev/CI는 false(빠른 부팅)

# ===== 저장소 백엔드 =====
# 기본 memory = 인메모리(휘발성). DB 서버 없이 부팅용.
# ※ 현재 DB 영속화는 스텁(미구현, TODO #2) — mysql로 바꿔도 아직 영속화 안 됨. db/ 구현 후 전환.
GLOSSARY_STORE_BACKEND=memory   # memory | mysql  (glossary 쪽은 아직 코드 미사용)
CONTENT_STORE_BACKEND=memory    # memory | mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=