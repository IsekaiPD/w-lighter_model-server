# ===== 필수: 비밀키 (기본값 없음) =====
# 텍스트·이미지·가이드(LLM) 호출
OPENAI_API_KEY=

# ===== translation 라이브 (mock=false) =====
# KURE 임베딩 다운로드용. 보통 비워도 됨.
HF_TOKEN=
# self-host Qdrant URL. 비우면 임베디드(path=) 폴백.
# 배포(compose)는 http://qdrant:6333.
QDRANT_URL=
# kculture 문화 각주 검색 임계치(코사인).
WLIGHTER_ANNOTATION_SCORE_THRESHOLD=0.55

# ===== 요청 제한 =====
# API 요청 JSON body 전체 크기 제한. 기본 512KB.
MAX_REQUEST_BODY_BYTES=524288

# ===== 모델 (기본값 있음 — 바꿀 때만 설정) =====
# 텍스트(채팅) 단일 노브 — translation/guide/character/relationship 공통.
WLIGHTER_TEXT_MODEL=gpt-5.4-mini
# 이미지(cover) 생성.
WLIGHTER_IMAGE_MODEL=gpt-image-2
WLIGHTER_IMAGE_SIZE=1024x1536
WLIGHTER_IMAGE_QUALITY=medium
WLIGHTER_IMAGE_FORMAT=png

# ===== 동작 토글 (기본값 있음) =====
# true면 키/Qdrant 없이 결정적 mock.
WLIGHTER_MOCK_MODE=false
# true(1)면 가이드를 LLM으로 생성 (기본: 데이터 기반 deterministic).
WLIGHTER_GUIDE_LLM=false
# startup에 KURE/파이프라인 1회 적재. prod는 1 권장(콜드스타트 방지), dev/CI는 false(빠른 부팅).
WARMUP_ON_STARTUP=false

# ===== 저장소 백엔드 =====
# 콘텐츠 영속화(works/episodes/characters/translation_results).
#   rdb(기본) = SQLAlchemy. 로컬은 DATABASE_URL 비우면 SQLite 폴백(DB 서버 불요), 배포는 DATABASE_URL만 MySQL로.
#   memory    = 인메모리(휘발성). 테스트/CI는 SQLite 파일 오염 방지 위해 memory 사용.
CONTENT_STORE_BACKEND=rdb
# rdb일 때 연결 URL. 비우면 로컬 SQLite(model_server/wlighter_local.db).
DATABASE_URL=

# glossary는 별도 추상화(domains/translation/glossary)
#   memory(기본) | mysql(raw PyMySQL). 컬럼명은 ERD(original_word/translated_word/glossary_type/target_country/memo)로 정렬.
GLOSSARY_STORE_BACKEND=memory
# GLOSSARY_STORE_BACKEND=mysql 일 때만 사용:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ===== S3 표지 이미지 저장 =====
# EC2 IAM Role 방식이면 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY는 필요 없음.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_URL=
# 표지 이미지 S3 key prefix. 기본 covers.
AWS_S3_COVER_PREFIX=covers
# private 버킷 미리보기용 presigned URL 만료 초. 기본 3600초.
AWS_S3_PRESIGNED_EXPIRES=3600
RATE_LIMIT_ENABLED=true

ENABLE_DOCS=true